# Carpschool Central Authority Server - Environment Configuration

# Server Port
PORT=4000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String (No auth, internal network)
# In Docker Compose, the host is 'central-mongo'
MONGO_URI=mongodb://central-mongo:27017/central_db

# Clerk Authentication Keys (From Clerk Dashboard: https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# Central Server Ed25519 Cryptographic Keys (Base64 encoded 32-byte keys)
# Generate with: node -e "const nacl = require('tweetnacl'); const kp = nacl.sign.keyPair(); console.log('PRIV:', Buffer.from(kp.secretKey).toString('base64')); console.log('PUB:', Buffer.from(kp.publicKey).toString('base64'));"
CENTRAL_ED25519_PRIVATE_KEY=YOUR_BASE64_ED25519_SECRET_KEY
CENTRAL_ED25519_PUBLIC_KEY=YOUR_BASE64_ED25519_PUBLIC_KEY

# Outbound Email Service (for security@carpschool.ca)
# Options: resend, smtp, mock
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=security@carpschool.ca
SMTP_PASS=YOUR_APP_SPECIFIC_PASSWORD
