# Central server env: ONLY these. Everything else is in MongoDB settings (edit in web as network admin)
# or on the data/ volume (signing key, auto-generated; mount ./data persistently).
PORT=3101
NODE_ENV=production
MONGO_URI=mongodb://mongo:27017/carpschool-central
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# First boot: node scripts/settings.mjs publicUrl=https://central.example corsOrigins=https://app.example
